{
  "redirects": [
    {
      "source": "/",
      "destination": "/owner/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/owner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/tofu-quiz/owner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}